<mxfile host="app.diagrams.net" modified="2026-10-05T00:00:00.000Z" agent="GitHub Copilot" version="24.7.17" type="device">
  <diagram id="use-case" name="Figure 4.2 - EchoDispatch Use Case Diagram">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Figure 4.2: EchoDispatch Use Case Diagram" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=22;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="740" height="40" as="geometry"/></mxCell>
        <mxCell id="system" value="EchoDispatch Ride Booking System" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#5b9bd5;dashed=1;verticalAlign=top;align=left;spacingTop=12;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1000" height="760" as="geometry"/></mxCell>

        <mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="280" width="70" height="120" as="geometry"/></mxCell>
        <mxCell id="partner" value="Partner / Driver" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="500" width="90" height="120" as="geometry"/></mxCell>
        <mxCell id="admin" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1350" y="280" width="90" height="120" as="geometry"/></mxCell>

        <mxCell id="register" value="Register and verify email&#xa;/api/auth/register, /api/auth/verify-email" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=12;" vertex="1" parent="system"><mxGeometry x="60" y="75" width="210" height="65" as="geometry"/></mxCell>
        <mxCell id="login" value="Sign in with credentials or Google&#xa;/api/auth/[...nextauth]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=12;" vertex="1" parent="system"><mxGeometry x="300" y="75" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="search" value="Search nearby vehicles&#xa;/api/vehicles/near-by" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=12;" vertex="1" parent="system"><mxGeometry x="570" y="75" width="200" height="65" as="geometry"/></mxCell>
        <mxCell id="booking" value="Create and manage booking&#xa;/api/booking/*, /api/user/bookings" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=12;" vertex="1" parent="system"><mxGeometry x="800" y="75" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="payment" value="Make and verify payment&#xa;/api/payment/create, /api/payment/verify" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=12;" vertex="1" parent="system"><mxGeometry x="1040" y="75" width="220" height="65" as="geometry"/></mxCell>

