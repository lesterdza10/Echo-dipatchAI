        <mxCell id="cancel" value="Cancel or confirm booking&#xa;/api/booking/[id]/cancel|confirm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=12;" vertex="1" parent="system"><mxGeometry x="930" y="250" width="210" height="65" as="geometry"/></mxCell>
